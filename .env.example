POSTGRES_USER=carril
POSTGRES_PASSWORD=carril
POSTGRES_DB=carril
POSTGRES_TEST_DB=carril_test
POSTGRES_PORT=5432
API_PORT=8000
JWT_SECRET=  # obligatorio, mínimo 32 caracteres: openssl rand -hex 32
JWT_EXPIRES_MINUTES=720
CORS_ORIGINS=http://localhost:4200
FORWARDED_ALLOW_IPS=127.0.0.1  # IPs del proxy HTTPS en producción (ver backend/docs/DEPLOYMENT.md)
WEB_PORT=8088  # vista previa (docker compose --profile preview), ver docs/PREVIEW.md
CARRIL_SEED=1  # 0 en producción: no carga demo@carril.dev (solo en el primer arranque del volumen)
